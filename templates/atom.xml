{# Extension of Zola's builtin atom template (zola 0.19+): adds <icon>,
   <logo>, <rights> and per-entry <category> elements on top of the
   builtin structure. Author resolution is unchanged: front matter
   `authors`, then config `author`, else the builtin "Unknown". #}
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ lang }}">
    <title>{{ config.title }}
    {%- if term %} - {{ term.name }}
    {%- elif section and section.title %} - {{ section.title }}
    {%- endif -%}
    </title>
    {%- if config.description %}
    <subtitle>{{ config.description }}</subtitle>
    {%- endif %}
    <link rel="self" type="application/atom+xml" href="{{ feed_url | safe }}"/>
    <link rel="alternate" type="text/html" href="
      {%- if section -%}
        {{ section.permalink | escape_xml | safe }}
      {%- else -%}
        {{ config.base_url | escape_xml | safe }}
      {%- endif -%}
    "/>
    <icon>{{ get_url(path="apple-touch-icon.png") | escape_xml | safe }}</icon>
    <logo>{{ get_url(path="images/logo.svg") | escape_xml | safe }}</logo>
    {# config.extra is not available in feed templates, so the legal
       name is hardcoded to match the footer's copyright line. #}
    <rights>Copyright © atvari GmbH</rights>
    <generator uri="https://www.getzola.org/">Zola</generator>
    {% if last_updated is defined %}<updated>{{ last_updated | date(format="%Y-%m-%dT%H:%M:%S%:z") }}</updated>{% endif %}
    <id>{{ feed_url | safe }}</id>
    {%- for page in pages %}
    <entry xml:lang="{{ page.lang }}">
        <title>{{ page.title }}</title>
        {% if page.date %}<published>{{ page.date | date(format="%Y-%m-%dT%H:%M:%S%:z") }}</published>{% endif %}
        {% if page.updated %}<updated>{{ page.updated | date(format="%Y-%m-%dT%H:%M:%S%:z") }}</updated>{% elif page.date %}<updated>{{ page.date | date(format="%Y-%m-%dT%H:%M:%S%:z") }}</updated>{% endif %}
        {% if page.authors %}
        {% for author in page.authors %}
        <author><name>{{ author }}</name></author>
        {% endfor %}
        {% elif config.author %}
        <author><name>{{ config.author }}</name></author>
        {% else %}
        <author><name>Unknown</name></author>
        {% endif %}
        {% if page.taxonomies.tags %}
        {% for tag in page.taxonomies.tags %}
        <category term="{{ tag | escape_xml }}"/>
        {% endfor %}
        {% endif %}
        <link rel="alternate" type="text/html" href="{{ page.permalink | safe }}"/>
        <id>{{ page.permalink | safe }}</id>
        {% if page.summary %}
        <summary type="html">{{ page.summary }}</summary>
        {% else %}
        <content type="html" xml:base="{{ page.permalink | escape_xml | safe }}">{{ page.content }}</content>
        {% endif %}
    </entry>
    {%- endfor %}
</feed>
